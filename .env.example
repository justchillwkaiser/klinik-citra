# Pangkalan data (Postgres / Neon). Ganti dengan URL sebenar anda.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth — jana dengan: openssl rand -base64 32
AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Seed admin (prisma/seed.ts)
# - ADMIN_EMAIL lalai: admin@klinikcitra.my
# - Jika ADMIN_PASSWORD kosong, seed akan menjana kata laluan rawak dan
#   memaparkannya sekali dalam output seed (tidak disimpan di mana-mana).
# - Jika ditetapkan, minimum 12 aksara.
# JANGAN commit nilai sebenar ke dalam repo.
ADMIN_EMAIL="admin@klinikcitra.my"
ADMIN_PASSWORD=""
